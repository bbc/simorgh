  text-decoration: none;
  overflow-x: hidden;
  overflow-y: hidden;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  color: #141414;
}

@media (min-width: 20rem) and (max-width: 37.4375rem) {
