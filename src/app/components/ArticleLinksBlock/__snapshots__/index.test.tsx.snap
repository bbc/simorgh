  padding-inline-end: 2.375rem;
  height: auto;
  display: block;
  width: 100%;
}

.is-opera-mini .emotion-7 {
  position: relative;
  background-color: #E6E8EA;
  padding: 1rem;
  margin-bottom: 1rem;
  width: calc(100% - 0.5rem);
}

@media (min-width: 25rem) {
  .is-opera-mini .emotion-7 {
    width: calc(50% - 1rem);
  }
}

.emotion-8 {
  font-size: 0.9375rem;
  line-height: 1.25rem;
  font-family: ReithSerif,Helvetica,Arial,sans-serif;
  font-style: normal;
  font-weight: 700;
