  -webkit-text-decoration: underline;
  text-decoration: underline;
}

.emotion-69:focus .rounded-play-button__ring,
.emotion-69:hover .rounded-play-button__ring,
.emotion-69:focus .rounded-play-button__inner,
.emotion-69:hover .rounded-play-button__inner {
