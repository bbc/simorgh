}

.emotion-69:before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  content: '';
  overflow: hidden;
  z-index: 1;
}

.emotion-69 .rounded-play-button__ring,
.emotion-69 .rounded-play-button__triangle {
  color: #000;
}

.emotion-69:focus [class*='--hover'],
