exports[`ImagePlaceholderAmp should render dark mode version correctly 1`] = `
.emotion-0 {
  background-color: #3F3F42;
}

<div>
  <amp-img
    height="128px"
    src="foo"
    width="645px"
  >
    <div
      class="emotion-0"
      placeholder=""
    >
      <amp-img
        height="17px"
        media="(max-width: 24.9375rem)"
        src="data:image/svg+xml;base64,"
        style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
        width="60px"
      />
      <amp-img
        height="22px"
        media="(min-width: 25rem) and (max-width: 62.9375rem)"
        src="data:image/svg+xml;base64,"
        style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
        width="77px"
      />
      <amp-img
        height="27px"
        media="(min-width: 63rem)"
        src="data:image/svg+xml;base64,"
        style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
        width="93px"
      />
    </div>
    <div
      class="emotion-0"
      fallback=""
    >
      <amp-img
        height="17px"
        media="(max-width: 24.9375rem)"
        src="data:image/svg+xml;base64,"
        style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
        width="60px"
      />
      <amp-img
        height="22px"
        media="(min-width: 25rem) and (max-width: 62.9375rem)"
        src="data:image/svg+xml;base64,"
        style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
        width="77px"
      />
      <amp-img
        height="27px"
        media="(min-width: 63rem)"
        src="data:image/svg+xml;base64,"
        style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
        width="93px"
      />
    </div>
  </amp-img>
</div>
`;

