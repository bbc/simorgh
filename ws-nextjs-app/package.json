{
  "name": "simorgh-nextjs",
  "version": "1.0.0",
  "description": "Simorgh - Next.JS",
  "scripts": {
    "setupDevEnv": "cp ../envConfig/local.env .env && sed 's/:7080/:7081/g' .env > .env.tmp && mv .env.tmp .env && mkdir -p public && cp -r ../public/. public",
    "copyStaticFiles": "node scripts/copyStaticFiles.ts",
    "copyPublicFiles": "node scripts/copyPublicFiles.ts",
    "build:local": "yarn setupDevEnv && next build --webpack && yarn copyStaticFiles && yarn copyPublicFiles",
    "build:preview": "cp ../envConfig/preview1.env .env && next build --webpack && yarn copyPublicFiles",
    "build:preview1": "cp ../envConfig/preview1.env .env && next build --webpack && yarn copyPublicFiles",
    "build:preview2": "cp ../envConfig/preview2.env .env && next build --webpack && yarn copyPublicFiles",
    "build:test": "cp ../envConfig/test.env .env && next build --webpack && yarn copyPublicFiles",
    "build:live": "cp ../envConfig/live.env .env && next build --webpack && yarn copyPublicFiles",
    "build:live:debug": "rm -rf build && awk '{sub(/LOG_DIR=.+/,\"LOG_DIR='log'\")}1' ../envConfig/live.env > .env && next build --webpack && yarn copyPublicFiles",
    "build": "yarn build:local",
    "dev": "yarn setupDevEnv && next dev -p 7081 --webpack",
    "dev-https": "yarn setupDevEnv && next dev -p 7081 --experimental-https --webpack",
    "start": "NODE_ENV=production HOSTNAME=127.0.0.1 PORT=7081 node build/standalone/ws-nextjs-app/server.js",
    "stop": "lsof -t -i:7081 | xargs kill",
    "test": "jest --ci --colors --selectProjects='Unit Tests'",
    "test:integration": "jest --ci --colors --selectProjects='Integration Tests - Canonical' --selectProjects='Integration Tests - AMP' --selectProjects='Integration Tests - Lite'",
    "test:integration:canonical": "jest --ci --colors --selectProjects='Integration Tests - Canonical'",
    "test:integration:amp": "jest --ci --colors --selectProjects='Integration Tests - AMP'",
    "test:integration:lite": "jest --ci --colors --selectProjects='Integration Tests - Lite'",
    "cypress": "cypress run --browser chrome",
    "cypress:install": "cypress install",
    "cypress:application": "cypress run --browser chrome --spec ./cypress/e2e/application",
    "cypress:page-types": "cypress run --browser chrome --spec ./cypress/e2e/pageTypes",
    "cypress:special-features": "cypress run --browser chrome --spec ./cypress/e2e/specialFeatures",
    "playwright:e2e": "APP_ENV=local playwright test",
    "playwright:e2e:chrome": "APP_ENV=local PLAYWRIGHT_CHANNEL=chrome playwright test --headed",
    "playwright:e2e:test": "APP_ENV=test playwright test",
    "playwright:e2e:live": "APP_ENV=live playwright test",
    "playwright:e2e:ui": "APP_ENV=local playwright test --ui",
    "playwright:errorPage404": "yarn playwright:e2e playwright/pageTypes/errorPage404/errorPage404.spec.ts",
    "playwright:errorPage404:chrome": "yarn playwright:e2e:chrome playwright/pageTypes/errorPage404/errorPage404.spec.ts",
    "playwright:errorPage404:test": "yarn playwright:e2e:test playwright/pageTypes/errorPage404/errorPage404.spec.ts",
    "playwright:errorPage404:live": "yarn playwright:e2e:live playwright/pageTypes/errorPage404/errorPage404.spec.ts",
    "playwright:errorPage404:ui": "yarn playwright:e2e:ui playwright/pageTypes/errorPage404/errorPage404.spec.ts",
    "cypress:onefile": "CYPRESS_APP_ENV=live CYPRESS_SMOKE=false cypress run --spec './cypress/e2e/articlePage/*'",
    "cypress:oneserviceandonefile": "CYPRESS_APP_ENV=live CYPRESS_SMOKE=false CYPRESS_ONLY_SERVICE=mundo cypress run  --spec './cypress/e2e/articlePage/*'",
    "cypress:interactive": "cypress open --browser chrome",
    "test:e2e": "yarn stop && yarn build && run-p --race start cypress -- --e2e",
    "test:e2e:interactive": "yarn stop && yarn build && run-p --race start cypress:interactive -- --e2e"
  },
  "devDependencies": {
    "@cypress/webpack-preprocessor": "7.0.1",
    "@jest/environment": "30.2.0",
    "@jest/types": "30.2.0",
    "@playwright/test": "1.55.0",
    "@swc/core": "1.15.24",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "cypress": "15.11.0",
    "cypress-axe": "1.7.0",
    "cypress-multi-reporters": "2.0.5",
    "cypress-terminal-report": "7.2.1",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.2.0",
    "mocha-junit-reporter": "2.2.1",
    "next-test-api-route-handler": "5.0.5",
    "npm-run-all2": "8.0.4",
    "swc-loader": "0.2.7",
    "ts-node": "10.9.2"
  },
  "dependencies": {
    "next": "16.2.6",
    "sharp": "0.34.5",
    "temporal-polyfill": "0.3.0"
  }
}
