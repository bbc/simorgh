@media screen and (-ms-high-contrast:active) {
  .emotion-115 {
    background-color: transparent;
    outline: none;
  }
}

.emotion-117>svg {
  color: #FFFFFF;
  fill: currentColor;
  width: 1.0625rem;
  height: 0.75rem;
  margin: 0;
}

@media screen and (forced-colors:active) {
  .emotion-117>svg {
    fill: canvasText;
  }
}

