exports[`OnDemand Radio Page  should match snapshot for when podcastEpisodeLinkedData toggle is off 1`] = `
.emotion-0 {
  max-width: 63rem;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  -webkit-column-gap: 0.5rem;
  column-gap: 0.5rem;
}

@media (min-width: 37.5rem) {
  .emotion-0 {
    -webkit-column-gap: 1rem;
    column-gap: 1rem;
  }
}

@media (min-width: 63rem) {
  .emotion-0 {
    grid-template-columns: repeat(8, 1fr);
  }
}

@media (min-width: 80rem) {
  .emotion-0 {
    max-width: 80rem;
    grid-template-columns: repeat(20, 1fr);
  }
}

.emotion-1 {
  grid-column: 1/span 6;
  padding: 0 0.5rem;
}

@media (min-width: 25rem) {
  .emotion-1 {
    padding: 0 1rem;
  }
}

@media (min-width: 63rem) {
  .emotion-1 {
    grid-column: 2/span 6;
    padding: 0;
  }
}

@media (min-width: 80rem) {
  .emotion-1 {
    grid-column: 5/span 12;
  }
}

