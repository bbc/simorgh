{
  "name": "simorgh",
  "version": "1.0.0",
  "description": "Simorgh",
  "sideEffects": [
    "./src/app/legacy/psammead/moment-timezone-include/**/*.*",
    "./src/app/legacy/psammead/psammead-locales/**/*.*",
    "./cypress/**/*.*"
  ],
  "workspaces": {
    "packages": [
      "ws-nextjs-app",
      "ws-nextjs-app/utilities/getAgent",
      "src/app/routes/utils/fetchDataFromBFF",
      "src/app/routes/utils/fetchPageData"
    ]
  },
  "scripts": {
    "type-check": "tsc",
    "amp:validate": "node ./scripts/ampHtmlValidator",
    "build:storybook": "rm -rf build && cp envConfig/local.env .env && storybook build -c .storybook -o storybook_dist",
    "setupDevEnv": "cp envConfig/local.env .env && rm -rf envConfig/secret.env && ./scripts/checkSecretEnvVariables.sh",
    "dependencyFreshness": "node ./scripts/dependencyFreshness",
    "esmDependencyCheck": "node ./scripts/esmDependencyCheck.js",
    "lighthouse": "./scripts/lighthouseRun.sh",
    "prepare": "husky install",
    "storybook": "storybook dev -p 9001 -c .storybook",
    "test:local": "yarn test:lint && yarn test:dependencies && yarn test:unit && run-p --race start amp:validate",
    "test:dependencies": "node ./scripts/dependencyCheck",
    "test:lint": "biome check --max-diagnostics 50000 --diagnostic-level error ./src ./ws-nextjs-app ./data ./cypress",
    "test:lint:fix": "biome check --max-diagnostics 50000 --diagnostic-level error --write ./src ./ws-nextjs-app ./data ./cypress",
    "test:lint:only": "biome lint --max-diagnostics 50000 --diagnostic-level error ./src ./ws-nextjs-app ./data ./cypress",
    "test:lint:only:fix": "biome lint --max-diagnostics 50000 --diagnostic-level error --write ./src ./ws-nextjs-app ./data ./cypress",
    "test:pretty": "biome format --max-diagnostics 50000 --diagnostic-level error ./src ./ws-nextjs-app ./data ./cypress",
    "test:pretty:fix": "biome format --max-diagnostics 50000 --diagnostic-level error --write ./src ./ws-nextjs-app ./data ./cypress",
    "test:puppeteer": "jest --ci --colors --verbose ./puppeteer",
    "test:puppeteer:local": "PUPPETEER_APP_ENV=local yarn test:puppeteer",
    "test:unit": "test -z $CI && yarn test:unit:local || yarn test:unit:ci",
    "test:unit:local": "NODE_OPTIONS=--experimental-vm-modules jest --colors --shard=1/1 --testPathIgnorePatterns=\"puppeteer\" \"ws-nextjs-app\"",
    "test:unit:ci": "yarn test:unit:local --ci",
    "test:unit:watch": "yarn test:unit -- --watch",
    "test:unit:updatesnapshots": "NODE_OPTIONS=--experimental-vm-modules jest --updateSnapshot --silent=false --colors --testPathIgnorePatterns=\"src/integration/pages\" \"puppeteer\" \"ws-nextjs-app\"",
    "test:integration": "NODE_OPTIONS=\"--experimental-vm-modules\" node ws-nextjs-app/integration/utils/runTests.ts",
    "test:integration:updatesnapshots": "NODE_OPTIONS=\"--experimental-vm-modules\" node ws-nextjs-app/integration/utils/runTests.ts  --updateSnapshot",
    "test:linkey": "node scripts/linkeySetup.js && jest src/app/lib/config/services/*.test.js --verbose true; yarn test:linkey:cleanup",
    "test:linkey:cleanup": "find src/app/lib/config/services -type f -name '*.test.js' -delete",
    "updateMinorPatch": "rm -rf node_modules/ && yarn install && npm update && yarn install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbc/simorgh.git"
  },
  "keywords": [
    "BBC",
    "Article"
  ],
  "author": "BBC",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/bbc/simorgh/issues"
  },
  "homepage": "https://github.com/bbc/simorgh#readme",
  "resolutions": {
    "glob": "10.5.0",
    "@types/react": "19.2.14",
    "js-yaml": "3.14.2",
    "on-headers": "1.1.0",
    "react-is": "19"
  },
  "dependencies": {
    "@bbc/reverb-url-helper": "https://mybbc-analytics.files.bbci.co.uk/reverb-url-helper/bbc-reverb-url-helper-2.5.0.tgz",
    "@bbc/web-vitals": "2.6.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@optimizely/optimizely-sdk": "5.4.1",
    "@optimizely/react-sdk": "3.3.1",
    "@tanstack/query-async-storage-persister": "5.99.2",
    "@tanstack/react-query": "5.99.2",
    "@tanstack/react-query-persist-client": "5.99.2",
    "aws-embedded-metrics": "4.2.0",
    "dotenv": "17.4.2",
    "jalaali-js": "1.2.8",
    "js-cookie": "3.0.5",
    "lru-cache": "11.2.7",
    "moment": "2.30.1",
    "moment-timezone": "0.6.0",
    "ramda": "0.32.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-helmet": "6.1.0",
    "react-lazyload": "3.2.1",
    "undici": "8.1.0",
    "uuid": "13.0.1",
    "winston": "patch:winston@3.8.2#./patches/winston-file-descriptor.patch"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.5",
    "@babel/preset-react": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@biomejs/biome": "2.4.15",
    "@cypress/webpack-preprocessor": "7.0.1",
    "@emotion/babel-plugin": "11.13.5",
    "@emotion/jest": "11.14.2",
    "@happy-dom/jest-environment": "20.9.0",
    "@jest/environment": "30.2.0",
    "@jest/globals": "30.2.0",
    "@storybook/addon-a11y": "10.3.6",
    "@storybook/addon-docs": "10.3.6",
    "@storybook/builder-webpack5": "10.3.6",
    "@storybook/cli": "10.3.6",
    "@storybook/react-webpack5": "10.3.6",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/js-cookie": "^3.0.3",
    "@types/jsdom": "27.0.0",
    "@types/ramda": "0.31.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-helmet": "6.1.11",
    "@types/react-lazyload": "^3.2.0",
    "@types/testing-library__react": "10.2.0",
    "amphtml-validator": "1.0.38",
    "babel-jest": "30.3.0",
    "babel-loader": "10.1.1",
    "babel-plugin-dynamic-import-node": "2.3.3",
    "chromatic": "13.1.4",
    "colors": "^1.4.0",
    "crypto": "1.0.1",
    "cypress": "15.11.0",
    "cypress-axe": "1.7.0",
    "cypress-multi-reporters": "2.0.5",
    "cypress-terminal-report": "7.2.1",
    "depcheck": "1.4.7",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.2.0",
    "jest-expect-message": "1.1.3",
    "jsdom": "27.0.0",
    "lighthouse": "13.0.1",
    "minimist": "1.2.8",
    "mkdirp": "3.0.1",
    "mocha-junit-reporter": "2.2.1",
    "puppeteer": "24.22.3",
    "retry": "0.13.1",
    "storybook": "10.3.6",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "typescript": "5.9.3",
    "webpack": "5.106.2"
  },
  "spec": {
    "executable": [
      "./bake-scripts/*"
    ],
    "post": [
      "mkdir -p /etc/bake-scripts/",
      "cp -R -af /usr/lib/simorgh/bake-scripts/* /etc/bake-scripts"
    ],
    "prune": false,
    "requires": [
      "cloud-init"
    ]
  },
  "packageManager": "yarn@4.9.4"
}
