            {
              "id": "46e9a25e",
              "type": "timestamp",
              "model": {
                "firstPublished": 1767372573529,
                "lastPublished": 1767372573529
              },
              "position": [4]
            },
            {
              "id": "7de6fd6c",
              "type": "text",
              "model": {
                "suitableForAbridgement": false,
                "blocks": [
                  {
                    "id": "cf8dbfa2",
                    "type": "paragraph",
                    "model": {
                      "text": "الرئيس دونالد ترامب لم يفوّت فرصة حصول النجم جورج كلوني وزوجته أمل علم الدين على الجنسية الفرنسية دون سخرية.",
                      "blocks": [
                        {
                          "id": "8ffe5943",
                          "type": "fragment",
                          "model": {
                            "text": "الرئيس دونالد ترامب لم يفوّت فرصة حصول النجم جورج كلوني وزوجته أمل علم الدين على الجنسية الفرنسية دون سخرية.",
                            "attributes": []
                          },
                          "position": [5, 1, 1]
                        }
                      ]
                    },
                    "position": [5, 1]
                  },
                  {
                    "id": "e3173cdc",
                    "type": "paragraph",
                    "model": {
                      "text": "فمن منصته \"تروث سوشال\"، وصف ترامب الزوجين بأنهما \"أسوأ متنبئين سياسيين\"، وسخر من انتقالهما لفرنسا قائلاً إن \"فرنسا التي تعاني من الجريمة وسوء إدارة الهجرة تماماً كما حدث في عهد بايدن. ولم يتوقف عند هذا، بل قلل من تاريخ كلوني الفني واصفاً إياه بالممثل المتواضع.. ليرد كلوني بجملة واحدة هزت منصات التواصل أنا أتفق تماماً مع الرئيس الحالي.. علينا فعلاً أن نجعل أمريكا عظيمة مرة أخرى وسنبدأ في نوفمبر القادم ملمحاً إلى الانتخابات النصفية في نوفمبر 2026 للإطاحة بنفوذ ترامب",
                      "blocks": [
                        {
                          "id": "187dee87",
                          "type": "fragment",
                          "model": {
                            "text": "فمن منصته \"تروث سوشال\"، وصف ترامب الزوجين بأنهما \"أسوأ متنبئين سياسيين\"، وسخر من انتقالهما لفرنسا قائلاً إن \"فرنسا التي تعاني من الجريمة وسوء إدارة الهجرة تماماً كما حدث في عهد بايدن. ولم يتوقف عند هذا، بل قلل من تاريخ كلوني الفني واصفاً إياه بالممثل المتواضع.. ليرد كلوني بجملة واحدة هزت منصات التواصل أنا أتفق تماماً مع الرئيس الحالي.. علينا فعلاً أن نجعل أمريكا عظيمة مرة أخرى وسنبدأ في نوفمبر القادم ملمحاً إلى الانتخابات النصفية في نوفمبر 2026 للإطاحة بنفوذ ترامب",
                            "attributes": []
                          },
                          "position": [5, 2, 1]
                        }
                      ]
                    },
                    "position": [5, 2]
                  },
                  {
                    "id": "d8e00061",
                    "type": "paragraph",
                    "model": {
                      "text": "يمكنكم مشاهدة الحلقات اليومية من البرنامج الساعة الثالثة بتوقيت غرينيتش، من الإثنين إلى الجمعة، وبإمكانكم أيضا الاطلاع على قصص ترندينغ بالضغط هنا.",
