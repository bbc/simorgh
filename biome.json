{
  "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "src/**/*",
      "ws-nextjs-app/**/*",
      "data/**/*",
      "webpack.config*",
      "!**/cypress",
      "!**/src/integration/**/*",
      "!**/ws-nextjs-app/integration/**/*",
      "!**/ws-nextjs-app/public/**/*",
      "!**/ws-nextjs-app/build/**/*",
      "!**/src/app/hooks/useImageColour/colorthief.js"
    ]
  },
  "formatter": {
    "enabled": false,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "a11y": {
        "useKeyWithClickEvents": "error"
      },
      "complexity": {
        "useOptionalChain": "error"
      },
      "correctness": {
        "noUndeclaredVariables": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "useValidTypeof": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error"
      },
      "style": {
        "noParameterAssign": "error",
        "useImportType": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noConsole": "warn",
        "noExplicitAny": "off",
        "noGlobalAssign": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "asNeeded",
      "quoteStyle": "single"
    },
    "globals": [
      "React",
      "BufferEncoding",
      "jest",
      "expect",
      "describe",
      "it",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
      "test"
    ]
  }
}